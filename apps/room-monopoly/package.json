{
  "name": "moyu-monopoly",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && cd dist && zip -qrFS ../moyu-monopoly.room.zip .",
    "validate:local": "node scripts/validate-local.mjs",
    "dev:room": "vite build --watch --mode room-dev",
    "build:room": "vite build --mode room-build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
