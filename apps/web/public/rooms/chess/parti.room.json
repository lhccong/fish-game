{
  "partiVersion": "0.1.0",
  "protocolVersion": 1,
  "id": "moyu-gomoku-go",
  "name": "五子棋与围棋",
  "version": "0.1.0",
  "packageMode": "filesystem",
  "cover": "cover.jpg",
  "entry": {
    "ui": "index.html",
    "worker": "room.worker.js"
  },
  "description": "二合一棋类游戏：五子棋与围棋一键切换，支持人机、在线联机两种模式。支持围棋死活协商阶段（end_confirm）、单方面退出不判负。",
  "tags": [
    "turn-based"
  ],
  "author": {
    "name": "弈合"
  },
  "actions": {
    "joinOnline": {
      "payload": "可选 { gameType }"
    },
    "chooseSide": {
      "payload": "{ side: 'black'|'white' }"
    },
    "leaveSide": {
      "payload": ""
    },
    "setGameType": {
      "payload": "{ gameType: 'gomoku'|'go' }"
    },
    "setAiLevel": {
      "payload": "{ level: 0|1|2|3 }"
    },
    "setHostSide": {
      "payload": "{ side: 'black'|'white' }"
    },
    "setMode": {
      "payload": "{ mode: 'ai'|'online' }"
    },
    "toggleReady": {
      "payload": ""
    },
    "startGameOnline": {
      "payload": ""
    },
    "startAI": {
      "payload": "{ gameType, hostSide: 'black'|'white' }"
    },
    "place": {
      "payload": "{ r, c }"
    },
    "pass": {
      "payload": ""
    },
    "continueGame": {
      "payload": ""
    },
    "confirmDead": {
      "payload": ""
    },
    "undo": {
      "payload": ""
    },
    "resign": {
      "payload": ""
    },
    "restart": {
      "payload": ""
    },
    "exitRoom": {
      "payload": ""
    },
    "respondRequest": {
      "payload": "{ accept: boolean }"
    }
  },
  "room": {
    "minPlayers": 1,
    "maxPlayers": 2,
    "allowSpectators": false
  },
  "sync": {
    "mode": "snapshot"
  },
  "permissions": {
    "network": false,
    "storage": "session"
  }
}