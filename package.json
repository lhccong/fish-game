{
  "name": "parti",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "Parti — Web 多人互动房间 Runtime",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@parti/web -- --host",
    "dev:mock": "node scripts/lobby-mock.mjs",
    "room:dev": "node scripts/room-dev.mjs",
    "lobby:mock": "node scripts/lobby-mock.mjs",
    "lobby:dev": "node scripts/lobby-mock.mjs",
    "build": "node scripts/room-build.mjs",
    "build:web": "npm run build --workspace=@parti/web",
    "start": "node --import tsx scripts/start.mjs",
    "start:prod": "node --import tsx scripts/start.mjs",
    "preview": "npm run preview --workspace=@parti/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@parti/room-source": "*",
    "@types/node": "^26.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
